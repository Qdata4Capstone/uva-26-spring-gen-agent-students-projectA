# ============================================================
# Mental_Health_Bot — Environment Variables
# Copy to backend/.env and fill in ANTHROPIC_API_KEY.
# NEVER commit your real .env to version control.
# ============================================================

# -- Anthropic (REQUIRED) -------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# -- App ------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# -- Claude ---------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-20250514
MAX_RESPONSE_TOKENS=1024
SESSION_MEMORY_TURNS=10

# -- MCP Server -----------------------------------------------
# These are AUTO-DETECTED — only uncomment if your layout differs.
#
# MCP_SERVER_PATH=/absolute/path/to/mcp_server/server.py
# MCP_PYTHON=/path/to/your/venv/bin/python
#
# By default:
#   MCP_SERVER_PATH = <repo_root>/mcp_server/server.py
#   MCP_PYTHON      = sys.executable (same Python running uvicorn)

# -- PubMed / NCBI (optional) ---------------------------------
# Get a free key at https://www.ncbi.nlm.nih.gov/account/
# Raises rate limit from 3 req/s to 10 req/s
# NCBI_API_KEY=your-ncbi-key-here
