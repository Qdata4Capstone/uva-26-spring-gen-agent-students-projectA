# ============================================================
# Mental_Health_Bot — Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit your real .env file to version control.
# ============================================================

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Claude ───────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-20250514
MAX_RESPONSE_TOKENS=1024
SESSION_MEMORY_TURNS=10

# ── MCP Server ───────────────────────────────────────────────
# Optional: absolute path to mcp_server/server.py (omit both lines to use defaults)
# MCP_SERVER_PATH=C:\path\to\mental-health-bot\mcp_server\server.py
# MCP_PYTHON=C:\path\to\python.exe

# ── PubMed / NCBI ────────────────────────────────────────────
# Optional — raises rate limit from 3 to 10 req/s (free signup)
NCBI_API_KEY=

# Optional — max PubMed + trial items per chat turn (default 3, max 10)
# MAX_RESEARCH_SOURCES_PER_TURN=3
